[debug] [2026-04-24T21:58:41.683Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/elfarouk-store/rulesets {"name":"projects/elfarouk-store/rulesets/c878387b-985f-4162-91e6-8f17922d88fd","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() {\n      return request.auth != null;\n    }\n\n    function userOwnsDoc(id) {\n      return signedIn() && request.auth.uid == id;\n    }\n\n    function userPath() {\n      return /databases/$(database)/documents/users/$(request.auth.uid);\n    }\n\n    function userRole() {\n      return signedIn() && exists(userPath()) ? get(userPath()).data.role : null;\n    }\n\n    function isAdmin() {\n      return signedIn() && userRole() == 'admin';\n    }\n\n    function isCustomer() {\n      return signedIn() && userRole() == 'customer';\n    }\n\n    function userDocKeysAllowed() {\n      return request.resource.data.keys().hasOnly([\n        'role',\n        'name',\n        'phone',\n        'email',\n        'createdAt',\n        'updatedAt'\n      ]);\n    }\n\n    function customerAccountKeysAllowed() {\n      return request.resource.data.keys().hasOnly([\n        'uid',\n        'name',\n        'phone',\n        'status',\n        'createdAt',\n        'updatedAt'\n      ]);\n    }\n\n    function serviceMessageKeysAllowed() {\n      return request.resource.data.keys().hasOnly([\n        'bookingId',\n        'customerAuthUid',\n        'sender',\n        'text',\n        'createdAt',\n        'updatedAt'\n      ]);\n    }\n\n    function notificationKeysAllowed() {\n      return request.resource.data.keys().hasOnly([\n        'type',\n        'audience',\n        'bookingId',\n        'customerAuthUid',\n        'title',\n        'body',\n        'read',\n        'createdAt',\n        'updatedAt'\n      ]);\n    }\n\n    function serviceBookingCreateKeysAllowed() {\n      return request.resource.data.keys().hasOnly([\n        'name',\n        'phone',\n        'carModel',\n        'notes',\n        'day',\n        'slot',\n        'customerAuthUid',\n        'slotPrice',\n        'paymentLink',\n        'paymentStatus',\n        'status',\n        'createdAt',\n        'updatedAt'\n      ]);\n    }\n\n    function serviceSlotLockKeysAllowed() {\n      return request.resource.data.keys().hasOnly([\n        'bookingId',\n        'day',\n        'slot',\n        'createdAt',\n        'updatedAt'\n      ]);\n    }\n\n    function customerServiceLockKeysAllowed() {\n      return request.resource.data.keys().hasOnly([\n        'bookingId',\n        'day',\n        'slot',\n        'createdAt',\n        'updatedAt'\n      ]);\n    }\n\n    match /products/{id} {\n      allow read, write: if isAdmin();\n    }\n\n    match /categories/{id} {\n      allow read, write: if isAdmin();\n    }\n\n    match /suppliers/{id} {\n      allow read, write: if isAdmin();\n    }\n\n    match /customers/{id} {\n      allow read, write: if isAdmin();\n    }\n\n    match /invoices/{id} {\n      allow read, write: if isAdmin();\n    }\n\n    match /transactions/{id} {\n      allow read, write: if isAdmin();\n    }\n\n    match /expenses/{id} {\n      allow read, write: if isAdmin();\n    }\n\n    match /quotations/{id} {\n      allow read, write: if isAdmin();\n    }\n\n    match /users/{id} {\n      allow create: if isAdmin()\n        || (\n          userOwnsDoc(id)\n          && userDocKeysAllowed()\n          && request.resource.data.role == 'customer'\n        );\n\n      allow read: if isAdmin() || userOwnsDoc(id);\n\n      allow update: if isAdmin()\n        || (\n          userOwnsDoc(id)\n          && userDocKeysAllowed()\n          && resource.data.role == 'customer'\n          && request.resource.data.role == resource.data.role\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n            'name',\n            'phone',\n            'email',\n            'updatedAt'\n          ])\n        );\n\n      allow delete: if isAdmin();\n    }\n\n    match /stockLogs/{id} {\n      allow read, write: if isAdmin();\n    }\n\n    match /purchases/{id} {\n      allow read, write: if isAdmin();\n    }\n\n    match /customerAccounts/{id} {\n      allow create: if isAdmin()\n        || (\n          isCustomer()\n          && userOwnsDoc(id)\n          && customerAccountKeysAllowed()\n          && request.resource.data.uid == request.auth.uid\n          && request.resource.data.status == 'active'\n        );\n\n      allow read: if isAdmin()\n        || (isCustomer() && resource.data.uid == request.auth.uid);\n\n      allow update: if isAdmin()\n        || (\n          isCustomer()\n          && resource.data.uid == request.auth.uid\n          && customerAccountKeysAllowed()\n          && request.resource.data.uid == resource.data.uid\n          && request.resource.data.status == resource.data.status\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n            'name',\n            'phone',\n            'updatedAt'\n          ])\n        );\n\n      allow delete: if isAdmin();\n    }\n\n    match /serviceBookings/{id} {\n      allow create: if isAdmin()\n        || (\n          isCustomer()\n          && serviceBookingCreateKeysAllowed()\n          && request.resource.data.customerAuthUid == request.auth.uid\n          && request.resource.data.status == 'new'\n          && request.resource.data.paymentStatus == 'pending'\n          && request.resource.data.slotPrice == 50\n          && request.resource.data.name is string\n          && request.resource.data.phone is string\n          && request.resource.data.day is string\n          && request.resource.data.slot is string\n          && !exists(/databases/$(database)/documents/customerServiceLocks/$(request.auth.uid))\n          && existsAfter(/databases/$(database)/documents/customerServiceLocks/$(request.auth.uid))\n          && getAfter(/databases/$(database)/documents/customerServiceLocks/$(request.auth.uid)).data.bookingId == id\n          && getAfter(/databases/$(database)/documents/customerServiceLocks/$(request.auth.uid)).data.day == request.resource.data.day\n          && getAfter(/databases/$(database)/documents/customerServiceLocks/$(request.auth.uid)).data.slot == request.resource.data.slot\n          && existsAfter(/databases/$(database)/documents/serviceSlotLocks/$(request.resource.data.day + '__' + request.resource.data.slot))\n          && getAfter(/databases/$(database)/documents/serviceSlotLocks/$(request.resource.data.day + '__' + request.resource.data.slot)).data.bookingId == id\n          && getAfter(/databases/$(database)/documents/serviceSlotLocks/$(request.resource.data.day + '__' + request.resource.data.slot)).data.day == request.resource.data.day\n          && getAfter(/databases/$(database)/documents/serviceSlotLocks/$(request.resource.data.day + '__' + request.resource.data.slot)).data.slot == request.resource.data.slot\n        );\n\n      allow update, delete: if isAdmin();\n      allow read: if isAdmin()\n        || (isCustomer() && resource.data.customerAuthUid == request.auth.uid);\n    }\n\n    match /serviceSlotLocks/{id} {\n      allow read: if signedIn();\n\n      allow create: if isAdmin()\n        || (\n          isCustomer()\n          && serviceSlotLockKeysAllowed()\n          && id == request.resource.data.day + '__' + request.resource.data.slot\n          && request.resource.data.bookingId is string\n          && !exists(/databases/$(database)/documents/serviceSlotLocks/$(id))\n          && existsAfter(/databases/$(database)/documents/serviceBookings/$(request.resource.data.bookingId))\n          && getAfter(/databases/$(database)/documents/serviceBookings/$(request.resource.data.bookingId)).data.customerAuthUid == request.auth.uid\n          && getAfter(/databases/$(database)/documents/serviceBookings/$(request.resource.data.bookingId)).data.day == request.resource.data.day\n          && getAfter(/databases/$(database)/documents/serviceBookings/$(request.resource.data.bookingId)).data.slot == request.resource.data.slot\n        );\n\n      allow update, delete: if isAdmin();\n    }\n\n    match /customerServiceLocks/{id} {\n      allow read: if isAdmin() || (isCustomer() && id == request.auth.uid);\n\n      allow create: if isAdmin()\n        || (\n          isCustomer()\n          && id == request.auth.uid\n          && customerServiceLockKeysAllowed()\n          && request.resource.data.bookingId is string\n          && !exists(/databases/$(database)/documents/customerServiceLocks/$(id))\n          && existsAfter(/databases/$(database)/documents/serviceBookings/$(request.resource.data.bookingId))\n          && getAfter(/databases/$(database)/documents/serviceBookings/$(request.resource.data.bookingId)).data.customerAuthUid == request.auth.uid\n          && getAfter(/databases/$(database)/documents/serviceBookings/$(request.resource.data.bookingId)).data.day == request.resource.data.day\n          && getAfter(/databases/$(database)/documents/serviceBookings/$(request.resource.data.bookingId)).data.slot == request.resource.data.slot\n        );\n\n      allow update, delete: if isAdmin();\n    }\n\n    match /serviceMessages/{id} {\n      allow create: if (\n          isAdmin() && serviceMessageKeysAllowed()\n        ) || (\n          isCustomer()\n          && serviceMessageKeysAllowed()\n          && request.resource.data.customerAuthUid == request.auth.uid\n          && request.resource.data.sender == 'customer'\n        );\n\n      allow read: if isAdmin()\n        || (isCustomer() && resource.data.customerAuthUid == request.auth.uid);\n\n      allow update, delete: if isAdmin();\n    }\n\n    match /notifications/{id} {\n      allow create: if (\n          isAdmin() && notificationKeysAllowed()\n        ) || (\n          isCustomer()\n          && notificationKeysAllowed()\n          && request.resource.data.audience == 'admin'\n          && request.resource.data.customerAuthUid == request.auth.uid\n          && request.resource.data.read == false\n        );\n\n      allow read: if isAdmin()\n        || (isCustomer() && resource.data.customerAuthUid == request.auth.uid);\n\n      allow update: if isAdmin()\n        || (\n          isCustomer()\n          && resource.data.customerAuthUid == request.auth.uid\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n            'read',\n            'updatedAt'\n          ])\n          && request.resource.data.read is bool\n        );\n\n      allow delete: if isAdmin();\n    }\n\n    match /customerWallets/{id} {\n      allow read: if isAdmin() || (isCustomer() && id == request.auth.uid);\n      allow create, update, delete: if isAdmin();\n    }\n\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-04-24T21:58:40.534143Z","metadata":{"services":["cloud.firestore"]}}
