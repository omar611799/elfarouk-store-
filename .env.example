# ==============================================================================
# 🚗 ELFAROUK STORE — Environment Variables Template
# ==============================================================================

# ─────────────────────────────────────────────────────────────
# 1. CLIENT-SIDE (Vite Frontend - Public)
# ─────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=elfarouk-store.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=elfarouk-store
VITE_FIREBASE_STORAGE_BUCKET=elfarouk-store.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef
VITE_WHATSAPP_NUMBER=201115329887

# ─────────────────────────────────────────────────────────────
# 2. SERVER-SIDE (Vercel Serverless & Cloud Functions - Secret)
# ─────────────────────────────────────────────────────────────

# Firebase Admin Service Account Key (JSON String from Firebase Console -> Project Settings -> Service Accounts)
# Example: {"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
FIREBASE_SERVICE_ACCOUNT_KEY=

# WhatsApp Meta Cloud API (For sending automated reminders & invoices via backend)
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_ID=123456789012345

# Google Gemini API Key (Optional: for natural language variations in AI Assistant)
GEMINI_API_KEY=AIzaSy...

# Server-side payment webhook secret
PAYMENT_WEBHOOK_SECRET=

# Server-side SMTP settings for email verification (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME="ELFAROUK Service"
