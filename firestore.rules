rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userRole() {
      return signedIn() && exists(userPath()) ? get(userPath()).data.role : null;
    }

    function isAdmin() {
      return signedIn() && userRole() == 'admin';
    }

    function isCashier() {
      return signedIn() && userRole() == 'cashier';
    }

    function isStaff() {
      return isAdmin() || isCashier();
    }

    // ─── Products & Inventory ───
    match /products/{id} {
      allow read, write: if isStaff();
    }

    match /stockLogs/{id} {
      allow create, read: if isStaff();
      allow update, delete: if isAdmin();
    }

    match /categories/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ─── Suppliers & Purchases ───
    match /suppliers/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /purchases/{id} {
      allow read, write: if isAdmin();
    }

    match /supplierReturns/{id} {
      allow read, write: if isAdmin();
    }

    // ─── Customers & Invoices ───
    match /customers/{id} {
      allow read, write: if isStaff();
    }

    match /invoices/{id} {
      // Allow read publicly for WhatsApp invoice links (/receipt/:id)
      allow read: if true;
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    match /quotations/{id} {
      // Allow read publicly for WhatsApp quote links (/print-quote/:id)
      allow read: if true;
      allow write: if isAdmin();
    }

    match /transactions/{id} {
      allow create, read: if isStaff();
      allow update, delete: if isAdmin();
    }

    match /expenses/{id} {
      allow read, write: if isAdmin();
    }

    // ─── System Counters & Maintenance ───
    match /counters/{id} {
      allow read, write: if isStaff();
    }

    match /maintenance/{id} {
      allow read, write: if isStaff();
    }

    // ─── User Accounts (Staff Only) ───
    match /users/{id} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == id);
      allow write: if isAdmin();
    }

    // ─── Service Bookings (Admin Only) ───
    match /serviceBookings/{id} {
      allow read, write: if isStaff();
    }

    match /serviceMessages/{id} {
      allow read, write: if isStaff();
    }

    match /notifications/{id} {
      allow read, write: if isStaff();
    }

    // ─── Default Deny ───
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

